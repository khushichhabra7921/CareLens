# Copy this file to .env and fill in real values. Never commit .env.
#   PowerShell:  Copy-Item .env.example .env

# --- Postgres superuser (used only by the local Docker container) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser
POSTGRES_DB=carelens

# --- Loader/admin role (used by scripts/load_data.py) ---
LOADER_PASSWORD=change-me-loader

# --- Read-only role (used by the web app) ---
APP_DB_PASSWORD=change-me-app

# Connection details for scripts/tests running directly on your machine.
# (Inside Docker Compose the app overrides these with db:5432.)
# 5433, not 5432, because another local Postgres already uses 5432.
# 127.0.0.1, not localhost: on Windows 'localhost' tries IPv6 first, which Docker doesn't
# listen on, costing ~2s per connection.
DB_HOST=127.0.0.1
DB_PORT=5433

# --- API security ---
# Protects POST /api/reports. At least 20 characters. Generate one with:
#   py -3.12 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change-me-admin-key
# Optional: report requests allowed per client IP per window (defaults 5 per 600 s).
# REPORTS_RATE_LIMIT=5
# REPORTS_RATE_WINDOW_SECONDS=600

# --- Privacy ---
# Secret key for the name-token hashes used by the redactor (20+ characters). Changing it
# means re-running scripts/build_name_hashes.py. Generate like ADMIN_API_KEY above.
NAME_HASH_SALT=change-me-name-hash-salt

# --- LLM (optional: the app falls back to template reports if empty) ---
# Free key at https://console.groq.com/keys. Model: a current Groq production model, e.g.
# llama-3.3-70b-versatile (check https://console.groq.com/docs/models).
GROQ_API_KEY=
LLM_MODEL=
# LLM_TIMEOUT_SECONDS=20
# LLM_MAX_COMPLETION_TOKENS=1500

# TLS to Postgres: 'prefer' locally (Docker has no TLS), 'verify-full' for RDS.
DB_SSLMODE=prefer
