# Copy this file to .env and fill in real values. Never commit .env.
#   PowerShell:  Copy-Item .env.example .env

# --- Postgres superuser (used only by the local Docker container) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser
POSTGRES_DB=carelens

# --- Loader/admin role (used by scripts/load_data.py) ---
LOADER_PASSWORD=change-me-loader

# --- Read-only role (used by the web app) ---
APP_DB_PASSWORD=change-me-app

# Connection details for scripts/tests running directly on your machine.
# (Inside Docker Compose the app overrides these with db:5432.)
# 5433, not 5432, because another local Postgres already uses 5432.
# 127.0.0.1, not localhost: on Windows 'localhost' tries IPv6 first, which Docker doesn't
# listen on, costing ~2s per connection.
DB_HOST=127.0.0.1
DB_PORT=5433

# --- API security ---
# Protects POST /api/reports. Generate one with:
#   py -3.12 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change-me-admin-key

# --- LLM (optional: the app falls back to template reports if empty) ---
GROQ_API_KEY=
LLM_MODEL=

# TLS to Postgres: 'prefer' locally (Docker has no TLS), 'verify-full' for RDS.
DB_SSLMODE=prefer
